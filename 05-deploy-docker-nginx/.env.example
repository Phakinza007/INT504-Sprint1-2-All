TEAM_CODE=ip26-zen
# The team address path from the Sprint Portal (keep it inside the team; do not commit the real one).
TEAM_PATH=replace_with_team_path_from_portal
SERVER_NAME=ip26-zen.sit.kmutt.ac.th
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./certs

# Generate separate hex passwords with: openssl rand -hex 24
# Use hex values so MYSQL_PASSWORD is also safe inside DATABASE_URL.
MYSQL_DATABASE=group44
MYSQL_USER=group44
MYSQL_PASSWORD=replace_with_random_hex_password
MYSQL_ROOT_PASSWORD=replace_with_different_random_hex_password

# Local Node startup only; Compose builds its own URL using the values above.
PORT=3000
DATABASE_URL=mysql://group44:replace_with_random_hex_password@127.0.0.1:3306/group44
